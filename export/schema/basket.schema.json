{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "food-price-watch basket export: basket/<id>.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "basket-1.1"
    },
    "id": {
      "type": "string"
    },
    "country": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+(-[a-z]+)*$"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "market": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "basket": {
      "type": "object",
      "properties": {
        "basket_id": {
          "type": "string"
        },
        "per": {
          "const": "person-month"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "component": {
                "enum": [
                  "cereal",
                  "pulses",
                  "oil"
                ]
              },
              "commodity": {
                "type": "string"
              },
              "commodity_fr": {
                "type": "string"
              },
              "quantity": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "type": "string"
              }
            },
            "required": [
              "component",
              "commodity",
              "commodity_fr",
              "quantity",
              "unit"
            ],
            "additionalProperties": false
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "enum": [
              "cereal",
              "pulses",
              "oil"
            ]
          }
        },
        "definition": {
          "type": "string"
        }
      },
      "required": [
        "basket_id",
        "per",
        "components",
        "missing",
        "definition"
      ],
      "additionalProperties": false
    },
    "currency": {
      "type": "string"
    },
    "eligible": {
      "type": "boolean"
    },
    "dates": {
      "type": "object",
      "properties": {
        "forecast_origin": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        "data_up_to": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        "last_observed_month": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        "run_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "forecast_origin",
        "data_up_to",
        "last_observed_month",
        "run_at"
      ],
      "additionalProperties": false
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
          },
          "cost": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "month",
          "cost"
        ],
        "additionalProperties": false
      }
    },
    "forecast": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
          },
          "step": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "horizon": {
            "enum": [
              "nowcast_last_month",
              "nowcast_this_month",
              "next_month",
              "in_2_months",
              "in_3_months"
            ]
          },
          "p025": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "p10": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "p50": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "p90": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "p975": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "month",
          "step",
          "horizon",
          "p025",
          "p10",
          "p50",
          "p90",
          "p975"
        ],
        "additionalProperties": false
      }
    },
    "explanation": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string"
        },
        "fr": {
          "type": "string"
        }
      },
      "required": [
        "en",
        "fr"
      ],
      "additionalProperties": false
    },
    "attribution": {
      "type": "string",
      "pattern": "World Food Programme"
    }
  },
  "required": [
    "schema_version",
    "id",
    "country",
    "market",
    "basket",
    "currency",
    "eligible",
    "dates",
    "history",
    "forecast",
    "explanation",
    "attribution"
  ],
  "additionalProperties": false
}
