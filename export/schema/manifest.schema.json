{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "food-price-watch export: manifest.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.6"
    },
    "status": {
      "enum": [
        "preview",
        "beta",
        "published"
      ]
    },
    "generated_at": {
      "type": "string"
    },
    "forecast_origin": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "data_up_to": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "model_version": {
      "type": "string"
    },
    "run_at": {
      "type": "string"
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+(-[a-z]+)*$"
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "series": {
          "type": "integer"
        },
        "series_with_forecast": {
          "type": "integer"
        }
      },
      "required": [
        "series",
        "series_with_forecast"
      ],
      "additionalProperties": false
    },
    "attribution": {
      "type": "string",
      "pattern": "World Food Programme"
    },
    "attribution_fr": {
      "type": "string",
      "pattern": "Programme alimentaire mondial"
    },
    "license": {
      "type": "object",
      "properties": {
        "data": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "data",
        "url"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disclaimer": {
      "type": "string"
    },
    "disclaimer_fr": {
      "type": "string"
    },
    "missing_translations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "status",
    "generated_at",
    "forecast_origin",
    "data_up_to",
    "model_version",
    "run_at",
    "countries",
    "counts",
    "attribution",
    "attribution_fr",
    "license",
    "sources",
    "disclaimer",
    "disclaimer_fr",
    "missing_translations",
    "files"
  ],
  "additionalProperties": false
}
